{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/thumbnail_concept",
  "title": "Thumbnail Concept",
  "description": "Three thumbnail concepts per episode, each with character expression, composition, lighting, overlay text, and image-generation prompt.",
  "type": "object",
  "required": ["version", "project_id", "concepts"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string" },
    "concepts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "main_character_expression", "background", "lighting", "color_contrast", "composition", "overlay_text", "image_prompt", "negative_prompt"],
        "properties": {
          "id": { "type": "string" },
          "main_character_expression": { "type": "string" },
          "secondary_element": { "type": "string", "description": "Secondary character or important object" },
          "background": { "type": "string" },
          "lighting": { "type": "string" },
          "color_contrast": { "type": "string" },
          "composition": { "type": "string" },
          "overlay_text": { "type": "string", "minLength": 2, "maxLength": 40, "description": "2-5 word thumbnail text" },
          "image_prompt": { "type": "string" },
          "negative_prompt": { "type": "string" },
          "rendered_image_path": { "type": "string", "description": "Set after the image has been generated" }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
